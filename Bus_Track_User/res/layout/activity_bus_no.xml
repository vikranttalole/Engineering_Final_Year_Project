<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context=".BusNoActivity" >

    <EditText
        android:id="@+id/bno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:textSize="16sp"
        android:hint="enter bus number" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignLeft="@+id/bno"
        android:layout_below="@+id/button1"
        android:layout_marginTop="39dp"
        android:orientation="vertical" >

         <TextView
            android:id="@+id/bnum"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="19dp"
            android:background="#83bfb3"
            android:text="Bus number"
            
            android:textSize="18sp" />
        <TextView
            android:id="@+id/src"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="19dp"
            android:background="#83bfb3"
            android:text="Source"
            
            android:textSize="18sp" />

        <TextView
            android:id="@+id/des"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="16dp"
            android:background="#83bfb3"
            android:text="Destination"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tm"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="16dp"
            android:background="#83bfb3"
            android:text="Time"
            android:textSize="18sp" />
        
        <TextView
            android:id="@+id/youAt"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="19dp"
            android:background="#83bfb3"
            android:text=" Present Location "
            
            android:textSize="18sp" />
        
        
    </LinearLayout>

    <Button
        android:id="@+id/button1"
        style="?android:attr/buttonStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/bno"
        android:layout_alignTop="@+id/bno"
        android:layout_toRightOf="@+id/bno"
        android:text="search" />

</RelativeLayout>
