<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/busss"
   
    tools:context=".LoginActivity" >
     <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:alpha="0.7" />
    

    <Button
        android:id="@+id/driverlbtn"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:background="#ef8b8b"
        android:layout_alignLeft="@+id/driverp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="200dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginStart="60dp"
       
        android:text="Login" />


    <EditText
        android:id="@+id/driverp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignLeft="@+id/drivern"
        android:layout_alignRight="@+id/drivern"
        android:layout_centerVertical="true"
                android:layout_gravity="center"
                        android:gravity="center"
                
        
        android:ems="10"
        android:hint="Password"
         
        android:background="#e0e88b"
        android:inputType="textPassword" />

    <EditText
        android:id="@+id/drivern"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_above="@+id/driverp"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="59dp"
        android:ems="10"
        android:layout_gravity="center"
                        android:gravity="center"
          android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:background="#e0e88b"
        android:hint="Staff ID" >

</EditText>
   

</RelativeLayout>