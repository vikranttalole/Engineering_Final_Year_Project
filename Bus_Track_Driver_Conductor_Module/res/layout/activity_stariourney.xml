<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context=".StariourneyActivity" >

   <Spinner
    android:id="@+id/busnospin"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content" 
  
    />

   <Spinner
       android:id="@+id/busrout"
       android:layout_width="fill_parent"
       android:layout_height="wrap_content"
       android:layout_alignLeft="@+id/busnospin"
       android:layout_below="@+id/busnospin"
       
        />

   <Spinner
       android:id="@+id/source"
       android:layout_width="fill_parent"
       android:layout_height="wrap_content"
       android:layout_alignLeft="@+id/busrout"
       android:layout_below="@+id/busrout"
       android:layout_marginTop="14dp" />

   <Spinner
       android:id="@+id/destination"
       android:layout_width="fill_parent"
       android:layout_height="wrap_content"
       android:layout_alignLeft="@+id/source"
       android:layout_below="@+id/source"
       android:layout_marginTop="28dp" />

   <Button
       android:id="@+id/srtbtn"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:layout_alignTop="@+id/destination"
       android:layout_centerHorizontal="true"
       android:layout_marginTop="33dp"
       android:text="START" />

</RelativeLayout>
